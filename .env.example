# Copia este archivo como .env y coloca tus claves reales.
DVYER_API_KEY=
DVYER_API_BASE_URL=https://dv-yer-api.online
EVOGB_API_KEY=
EVOGB_API_BASE_URL=https://api.evogb.org
APISPERU_TOKEN=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1/
MAX_UPLOAD_BYTES=94371840
SEARCH_LIMIT=5
NERO_PHONE=
BAILEYS_LOG_LEVEL=silent

# IDs LID de owners separados por coma (solo si WhatsApp no entrega el número)
OWNER_LIDS=50148205949148

# Opcional: fuerza la versión WA Web si WhatsApp vuelve a rechazar la vinculación.
# Formato: 2,3000,1034074495
NERO_WA_VERSION=

# Nero v1.18.8 — estabilidad Panel/VPS
COMMAND_RESPONSE_DELAY_MS=5000
NERO_TMP_DIR=tmp/runtime
NERO_DISK_RESERVE_MB=1024
# Panel ~10 GB: recomendado 9500
NERO_DISK_QUOTA_MB=
NERO_TMP_MAX_AGE_MINUTES=360
NERO_LOG_MAX_MB=2

# Multimedia
LARGE_MEDIA_MAX_SOURCE_MB=4096
ANIME_MAX_SOURCE_MB=6144
ANIME_SINGLE_DOCUMENT_MB=700
ANIME_SPLIT_PART_MB=700
MOVIE_SINGLE_DOCUMENT_MB=1900
MOVIE_SPLIT_PART_MB=700

# Panel sin PM2
NERO_SUBBOT_PROCESS_MANAGER=child
