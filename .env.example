# Copia este archivo como .env y coloca tu clave real.
DVYER_API_KEY=
DVYER_API_BASE_URL=https://dv-yer-api.online
MAX_UPLOAD_BYTES=94371840
SEARCH_LIMIT=5
NERO_PHONE=
BAILEYS_LOG_LEVEL=silent

# Spotify (EvoGB)
EVOGB_API_KEY=
EVOGB_API_BASE_URL=https://api.evogb.org

# API EvoGB: IA, anime, utilidades y moderación NSFW
EVOGB_API_KEY=coloca_tu_clave
EVOGB_API_BASE_URL=https://api.evogb.org

# IDs LID de owners separados por coma (solo si WhatsApp no entrega el número)
OWNER_LIDS=50148205949148

# Opcional: fuerza la versión WA Web si WhatsApp vuelve a rechazar la vinculación.
# Formato: 2,3000,1034074495
NERO_WA_VERSION=
